# n8n instance, no trailing slash
N8N_BASE_URL=https://n8n.example.com

# Settings > n8n API > Create an API key. Used to read executions.
N8N_API_KEY=

# The Content Automation workflow's ID (open the workflow, it is in the URL)
N8N_WORKFLOW_ID=

# Webhook path from the "Web dashboard trigger" node
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/content-automation

# Must match the TOKEN inside the "Normalise webhook input" node
N8N_TRIGGER_TOKEN=

# One shared password for the team. Anyone with it can publish to live sites.
CONSOLE_PASSWORD=
