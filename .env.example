# ---------------------------------------------------------------- auth
# Any random 32+ char string. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# JSON array of users. Generate each hash with:  npm run hash -- "the password"
# Keep it on ONE line.
AUTH_USERS=[{"email":"you@example.com","name":"You","passwordHash":"$2a$12$replace_me"}]

# ---------------------------------------------------------------- n8n
# Origin of your n8n instance, no trailing slash.
# n8n Cloud looks like https://yourname.app.n8n.cloud
N8N_BASE_URL=https://your-n8n-instance.example.com

# Settings > n8n API > Create an API key
N8N_API_KEY=

# The workflow whose executions this console lists.
N8N_WORKFLOW_ID=rK5Va4IFiHgasLWp

# How the run is kicked off.
#   webhook  the Webhook node from n8n-patch/ (recommended: returns the execution id)
#   form     POST straight at the existing Form Trigger (no execution id, matched by time)
N8N_TRIGGER_MODE=webhook

# Full URL of whichever trigger you chose.
#   webhook: https://your-n8n/webhook/content-automation/run
#   form:    https://your-n8n/form/ce3a2ada-92ec-4bf1-aace-cbc161fbfb54
N8N_TRIGGER_URL=https://your-n8n-instance.example.com/webhook/content-automation/run

# Optional. If set, sent as the x-trigger-secret header in webhook mode so the
# webhook URL alone is not enough to spend your API credits.
N8N_WEBHOOK_SECRET=

# ---- cost reporting --------------------------------------------------
# DataForSEO prices every call in its own response, so that part is exact and
# needs no configuration. Model usage arrives as token counts, so it is priced
# from these. Defaults are Claude Sonnet list prices in USD per million tokens.
COST_ANTHROPIC_INPUT_PER_MTOK=3
COST_ANTHROPIC_OUTPUT_PER_MTOK=15

# Image generation reports neither price nor tokens. Left at 0 the run panel
# counts the images and says they are unpriced rather than guessing.
COST_IMAGE_EACH=0

# Activity log storage (optional, but required for the Logs page to keep
# history on Vercel, where the filesystem is read-only).
# Attach a KV / Upstash Redis store to the project and Vercel sets these for
# you. Without them the log falls back to .data/audit.jsonl locally, or to
# memory-only in production, where it is lost on every instance recycle.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- domains ----------------------------------------------------------
# A GoDaddy Personal Access Token, from Account > API Keys. Read only in
# practice here — the Domains page lists what the account holds and changes
# nothing — but the token itself carries full account scope, so it lives in the
# environment and never reaches the browser.
#
# GoDaddy restricts this endpoint by account size. A perfectly valid token can
# still be refused with ACCESS_DENIED if the account holds too few domains; the
# page says so rather than blaming the token.
#
# Set GODADDY_API_SECRET only for an older key-and-secret pair. A gd_pat_ token
# is a single value and needs this one alone.
GODADDY_API_KEY=
# GODADDY_API_SECRET=
